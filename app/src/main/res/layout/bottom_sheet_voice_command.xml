<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_badge" />

    <!-- Header Row with Assistant Title & Security Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_voice_command"
            app:tint="@color/accent_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="0.04"
            android:text="PATHMIND VOICE ASSISTANT"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 100% Offline Badge for Judges -->
        <TextView
            android:id="@+id/tvOfflineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🟢 100% OFFLINE"
            android:textColor="@color/indicator_ready"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hero Microphone Interaction Centerpiece -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Outer Animated Ripple Container -->
        <FrameLayout
            android:id="@+id/layoutHeroMicContainer"
            android:layout_width="110dp"
            android:layout_height="110dp">

            <!-- Ripple Glow Ring -->
            <View
                android:id="@+id/viewRippleRing"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_mic_ripple"
                android:visibility="invisible" />

            <!-- Center Circular Hero Microphone Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeroMic"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/surface_card"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="38dp"
                app:elevation="6dp"
                app:icon="@drawable/ic_voice_command"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="@color/accent_cyan"
                app:strokeColor="@color/surface_card_stroke"
                app:strokeWidth="1.5dp" />
        </FrameLayout>

        <!-- Dynamic State Prompt Label -->
        <TextView
            android:id="@+id/tvVoiceStatePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tap microphone to speak"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Sub-prompt / Engine status -->
        <TextView
            android:id="@+id/tvVoiceStateSubPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vosk On-Device Engine • Zero Cloud"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Live Speech Transcript Card (Appears dynamically during speech) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLiveTranscript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvLiveTranscript"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Listening..."
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tvLiveLatencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="⚡ ASR"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Assistant Outcome / Result Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOutcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Result Badges Row: Status Icon/Badge, Entity Pill, Confidence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOutcomeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="READY"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOutcomeEntity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Target: Bike"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvOutcomeConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conf: 95%"
                    android:textColor="@color/indicator_ready"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Outcome Description / Feedback Message -->
            <TextView
                android:id="@+id/tvOutcomeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="Tap the microphone and speak a spatial command."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Stage 9: Optional Landmark Photo Attachment -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttachLandmarkPhoto"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/surface_dark"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:text="📷 ADD LANDMARK PHOTO"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="10dp"
                app:strokeColor="@color/surface_card_stroke"
                app:strokeWidth="1dp" />

            <!-- Stage 10 (Step 4): Disambiguation Candidates Container -->
            <LinearLayout
                android:id="@+id/layoutCandidatesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCandidatesPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="CHOOSE DESTINATION"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Container where candidate buttons are dynamically populated -->
                <LinearLayout
                    android:id="@+id/layoutCandidateButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- Cancel Selection Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:text="✕ Cancel Selection"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Primary Action Launch Button (Start Nav or View Memories) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchOutcomeAction"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/indicator_ready"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="START NAVIGATION"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Polished "Try Saying" Suggestions Carousel -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.06"
        android:text="TRY SAYING"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTrySaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTryFindBike"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where did I park my bike?"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/surface_card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTryRememberBike"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember where I parked my bike."
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/surface_card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTryStartRoute"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start my route."
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/surface_card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTryCancel"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/surface_card_stroke"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Collapsible "Type Instead" Secondary Drawer Toggle -->
    <LinearLayout
        android:id="@+id/layoutToggleManualInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvToggleManualText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨ Type a command instead"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Collapsible Manual Input Container (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutManualInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:hint="Type: Where is my bike?"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExecuteCommand"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="SEND"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
